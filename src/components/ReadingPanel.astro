---
// Inline reading & accessibility panel, rendered under the header on every page.
// Collapsed by default; Alt+Shift+A jumps to it. Source: src/scripts/a11y-panel.js
// Visitors' settings (and whether it's expanded) are saved per browser.
---

<div id="reading-options" class="reading-options" tabindex="-1"></div>

<script is:inline>
	window.a11yPanelConfig = {
		mount: '#reading-options',
		autoOpen: false,
		removable: false,
		label: 'Reading & accessibility options',
	};
</script>
<script>
	import '../scripts/a11y-panel.js';
</script>

<style>
	.reading-options {
		max-width: 1200px;
		margin: 0.75rem auto 0;
		padding: 0 1rem;
		/* Match the panel to the site's Material color tokens (follows light/dark theme) */
		--a11yp-accent: var(--md-sys-color-primary);
		--a11yp-on-accent: var(--md-sys-color-on-primary);
		--a11yp-bg: var(--md-sys-color-surface-container-low);
		--a11yp-fg: var(--md-sys-color-on-surface);
		--a11yp-muted: var(--md-sys-color-on-surface-variant);
		--a11yp-line: var(--md-sys-color-outline-variant);
		--a11yp-chip: var(--md-sys-color-surface-container-high);
	}
	.reading-options:focus {
		outline: none;
	}
</style>
