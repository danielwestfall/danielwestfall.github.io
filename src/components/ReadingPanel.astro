---
// Reading & accessibility panel: a button in the site header that drops a panel down under the top bar.
// Also owns the site's light/dark theme (Auto / Light / Dark in its Colors row).
// Alt+Shift+A opens it. Source: src/scripts/a11y-panel.js. Settings are saved per browser.
---

<div id="reading-options" class="reading-options"></div>

<script is:inline>
	window.a11yPanelConfig = {
		mount: '#reading-options',
		layout: 'dropdown',
		autoOpen: false,
		removable: false,
		label: 'Reading options',
		nativeTheme: { attr: 'data-theme', light: 'light', dark: 'dark' },
	};
</script>
<script>
	import '../scripts/a11y-panel.js';
</script>

<style>
	.reading-options {
		display: flex;
		align-items: center;
		/* Match the panel to the site's Material color tokens (follows light/dark theme) */
		--a11yp-accent: var(--md-sys-color-primary);
		--a11yp-on-accent: var(--md-sys-color-on-primary);
		--a11yp-bg: var(--md-sys-color-surface-container-low);
		--a11yp-fg: var(--md-sys-color-on-surface);
		--a11yp-muted: var(--md-sys-color-on-surface-variant);
		--a11yp-line: var(--md-sys-color-outline-variant);
		--a11yp-chip: var(--md-sys-color-surface-container-high);
		--a11yp-track: var(--md-sys-color-outline);
		--a11yp-ring: var(--md-sys-color-primary);
	}
</style>
